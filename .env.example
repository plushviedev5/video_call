# ============================================
# Video Calling Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# For cloud deployment, set these as environment variables
# in your hosting platform (Render, Railway, etc.)

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Database (PostgreSQL)
# Local:      postgresql://postgres:postgres@localhost:5432/videocall?schema=public
# Neon Cloud: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/videocall?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/videocall?schema=public

# Redis
# Local:   localhost / 6379 / no password / TLS=false
# Upstash: global-xxx.upstash.io / 6379 / AXxxxx / TLS=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# JWT (CHANGE THESE IN PRODUCTION — use: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-strong-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS (comma-separated origins for Flutter app)
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# BullMQ (uses same Redis or separate instance)
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=
BULL_REDIS_TLS=false

# Push Notifications (placeholder — configure when ready)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
FCM_SERVER_KEY=

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
